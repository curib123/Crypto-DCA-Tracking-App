generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  AIRDROP
  REWARD
  STAKING_REWARD
  FEE
  ADJUSTMENT
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum AdOverride {
  INHERIT
  ENABLED
  DISABLED
}

model User {
  id              String          @id @default(uuid())
  googleSubject   String          @unique
  email           String          @unique
  name            String?
  pictureUrl      String?
  baseCurrency    String          @default("USD")
  role            UserRole        @default(USER)
  status          UserStatus      @default(ACTIVE)
  themePreference ThemePreference @default(SYSTEM)
  adsOverride     AdOverride      @default(INHERIT)
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  transactions    Transaction[]
  auditLogs       AdminAuditLog[] @relation("AdminAuditActor")

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@index([lastLoginAt])
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetSymbol     String
  type            TransactionType
  quantity        Decimal         @db.Decimal(36, 18)
  unitPrice       Decimal         @db.Decimal(36, 8)
  amountSpent     Decimal         @db.Decimal(36, 8)
  quoteCurrency   String
  fxRateToBase    Decimal         @default(1) @db.Decimal(36, 12)
  feeBase         Decimal         @default(0) @db.Decimal(36, 8)
  exchange        String?
  wallet          String?
  notes           String?
  clientReference String?
  occurredAt      DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, assetSymbol])
  @@index([createdAt])
  @@unique([userId, clientReference])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actor       User     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model ControlPanelAdmin {
  id                 String                 @id @default(uuid())
  username           String                 @unique
  passwordHash       String
  mustChangePassword Boolean                @default(true)
  failedAttempts     Int                    @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  auditLogs          ControlPanelAuditLog[]

  @@index([username])
}

model ControlPanelAuditLog {
  id           String            @id @default(uuid())
  actorAdminId String
  actor        ControlPanelAdmin @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  action       String
  targetType   String
  targetId     String?
  metadata     Json?
  createdAt    DateTime          @default(now())

  @@index([actorAdminId, createdAt])
  @@index([createdAt])
}
