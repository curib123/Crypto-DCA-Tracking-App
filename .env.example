# NextFi — Vercel + Supabase PostgreSQL
NODE_ENV=development

# Supabase PostgreSQL.
# Runtime/serverless: use the transaction pooler connection string (usually port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Prisma migrations: use the Supabase direct or session-pooler connection string.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Google Identity Services (Google-only customer login).
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Same-origin Next.js API. Keep this as /api on Vercel and locally.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DEFAULT_BASE_CURRENCY=USD
COINGECKO_DEMO_API_KEY=

# Customer HttpOnly session signing secret. Use 32+ random characters in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Dedicated control-panel bootstrap and cookie signing.
# Production requires a non-default password (12+ chars) and a separate 32+ char secret.
CONTROL_PANEL_USERNAME=admin
CONTROL_PANEL_PASSWORD=replace-with-a-strong-bootstrap-password
CONTROL_PANEL_JWT_SECRET=replace-with-a-separate-long-random-control-panel-secret

# Optional Mistral AI. Leave the key blank for analytics-only insights.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_TIMEOUT_MS=12000

# Google AdSense. Ads remain OFF until enabled from the control panel.
ADSENSE_CLIENT_ID=
ADSENSE_APP_SLOT_ID=
ADSENSE_LANDING_SLOT_ID=
