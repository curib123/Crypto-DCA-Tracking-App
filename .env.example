NODE_ENV=development

POSTGRES_DB=crypto_dca
POSTGRES_USER=crypto_dca
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://crypto_dca:change-me@postgres:5432/crypto_dca?schema=public

PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
DEFAULT_BASE_CURRENCY=USD
COINGECKO_DEMO_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

APP_DOMAIN=example.com

# Legacy app-level role bootstrap. This does not grant control-panel access.
ADMIN_EMAILS=

# Dedicated control panel. admin/pass is DEVELOPMENT-ONLY and first login requires a password change.
# Production refuses to start with the default password or a short control-panel JWT secret.
CONTROL_PANEL_USERNAME=admin
CONTROL_PANEL_PASSWORD=pass
CONTROL_PANEL_JWT_SECRET=replace-with-a-separate-long-random-control-panel-secret

# Optional Mistral AI. Leave MISTRAL_API_KEY blank for analytics-only insights.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_TIMEOUT_MS=12000
MISTRAL_MAX_RETRIES=1

# Server-side API URL used by Next.js SSR in Docker.
API_INTERNAL_URL=http://api:4000/api

# Google AdSense setup. Ads stay OFF until enabled from the control panel.
# AdSense client and slot IDs are publisher identifiers, not private API secrets,
# but they are still configured only through server environment variables here.
ADSENSE_CLIENT_ID=
ADSENSE_APP_SLOT_ID=
ADSENSE_LANDING_SLOT_ID=
