# NextFi — Vercel + Next.js + Supabase Free
NODE_ENV=development

# Public Supabase project configuration.
# These values are safe for browser code; database passwords and privileged keys are not.
SUPABASE_PROJECT_REF=nzjpqochvjsnbqlzsflv
NEXT_PUBLIC_SUPABASE_URL=https://nzjpqochvjsnbqlzsflv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EgSMjmXkU1_QD_6JIqJdmw_rs4fDXuI

# Server-only PostgreSQL connections.
# Copy the exact pooler host from Supabase Dashboard -> Connect.
# URL-encode reserved characters in the database password before putting it in a URL.
# Vercel/runtime: Transaction Pooler, normally port 6543.
DATABASE_URL=postgresql://postgres.nzjpqochvjsnbqlzsflv:URL_ENCODED_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
# CLI/schema validation: Session Pooler (or direct connection where IPv6 is supported), normally port 5432.
DIRECT_URL=postgresql://postgres.nzjpqochvjsnbqlzsflv:URL_ENCODED_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Google Identity Services (Google-only customer login).
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Same-origin Next.js API.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

DEFAULT_BASE_CURRENCY=USD
COINGECKO_DEMO_API_KEY=

# Customer HttpOnly session signing secret. Use 32+ random characters in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Dedicated control-panel bootstrap and cookie signing.
CONTROL_PANEL_USERNAME=admin
CONTROL_PANEL_PASSWORD=replace-with-a-strong-bootstrap-password
CONTROL_PANEL_JWT_SECRET=replace-with-a-separate-long-random-control-panel-secret

# Optional Mistral AI. Leave the key blank for analytics-only insights.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_TIMEOUT_MS=12000

# Google AdSense. Ads remain OFF until enabled from the control panel.
ADSENSE_CLIENT_ID=
ADSENSE_APP_SLOT_ID=
ADSENSE_LANDING_SLOT_ID=

# Cross-platform delivery.
# Stable public APK asset produced by .github/workflows/android-apk.yml.
NEXT_PUBLIC_ANDROID_APK_URL=https://github.com/curib123/Crypto-DCA-Tracking-App/releases/download/android-latest/NextFi-android.apk
# Build-time URL used by the Capacitor Android shell.
CAPACITOR_SERVER_URL=https://web-nextfi.vercel.app
